{
  "name": "samuel-sermons-express",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "start": "node ./src/bin/www",
    "devstart": "nodemon ./src/bin/www",
    "devserver": "SET DEBUG=samuel-sermons-express:* & npm run devstart",
