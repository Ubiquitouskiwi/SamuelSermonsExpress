    "debug": "^2.6.9",
    "dotenv": "^17.0.0",
    "express": "^4.21.1",
    "express-async-handler": "^1.2.0",
    "express-rate-limit": "^8.4.1",
    "express-session": "^1.19.0",
    "express-validator": "^7.3.2",
    "helmet": "^8.1.0",
    "http-errors": "^1.8.1",
    "morgan": "^1.10.0",
    "multer": "^2.1.1",
    "pg": "^8.20.0",
    "pug": "^3.0.3"
  },
  "devDependencies": {
    "jest": "^30.0.2",
    "nodemon": "^3.1.7"
