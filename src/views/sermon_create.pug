extends layout
block content
  h1.page-header__title Sermon Creation
  hr.divider
  p
    | This is the page where you can submit sermons to the system.
    | The sermon title will be found on the folder. The Sermon 
    | Image Link is the link to the hosted scans, and the sermon
    | type is usually Sermon, Funeral, or Special Day.

  form
    .form-group
      label(for='sermonTitle') Sermon Title
      input#sermonTitle.form-input(type='text' placeholder='Sermon Title' required)
    .form-group
      label(for='sermonImageLink') Sermon Image Link
      input#sermonImageLink.form-input(type='text' placeholder='Sermon Image Link' required)
    .form-group
      label(for='sermonType') Sermon Type
      input#sermonType.form-input(list='sermonTypeList' placeholder='Sermon Type')
      datalist#sermonTypeList
        option(value='Sermon')
        option(value='Funeral')
        option(value='Special Day')
    .form-group
      button.btn.btn--primary(type='submit') Submit
      |  
      button.btn.btn--outline(type='reset') Clear
