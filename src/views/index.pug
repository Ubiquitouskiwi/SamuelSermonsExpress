extends layout
block head
  //- The faint hills background is the page's largest paint; let the browser fetch it early
  link(rel='preload' as='image' href='/images/wv-hills.webp' type='image/webp')
block content
  .home-bg
    section.hero(aria-labelledby="hero-title")
      img.hero__portrait(src='/images/samuel-starling-1.jpg' alt='Portrait of Rev. Samuel Starling' width='448' height='820' fetchpriority='high')
      hr.divider.divider--center(aria-hidden='true')
      h1#hero-title.hero__title Welcome to Samuel&apos;s Sermons
      p.hero__subtitle
        | This site is dedicated to preserving and sharing the powerful and inspiring sermons 
        | delivered by Rev. Samuel Starling during his years of ministry in the Methodist Church. 
        | These teachings reflect his wisdom, faith, and dedication to spiritual guidance.
      .hero__actions
        a.btn.btn--accent(href='/sermons') Explore Sermons
        a.btn.btn--outline(href='/about') About the Project

    //- Sermon of the Day
    if sermonOfDay
      section.section.sermon-of-day
        hr.divider.divider--center(aria-hidden='true')
        h2.sermon-of-day__heading Sermon of the Day
        - var sodMatch = /^(\d+)\.\s+(.+)$/.exec(sermonOfDay.title || '')
        - var sodName = sodMatch ? sodMatch[2] : sermonOfDay.title
        - var sodUrl = `/sermons/details?id=${sermonOfDay.id}`
        article.sermon-card
          .sermon-card__body
            h3.sermon-card__title
              a.sermon-card__link(href=sodUrl)= sodName
            .sermon-card__details
              if sodMatch
                p.sermon-card__meta No. #{sodMatch[1]}
              if sermonOfDay.sermonType
                ul.sermon-card__tags
                  li
                    span.badge(class=sermonOfDay.sermonType === 'sermon' ? 'badge--sermon' : sermonOfDay.sermonType === 'funeral' ? 'badge--funeral' : 'badge--special')= sermonOfDay.sermonType
          .sermon-card__actions
            a.btn.btn--small.btn--primary(href=sodUrl) Read This Sermon
