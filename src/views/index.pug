extends layout
block content
  .home-bg
    section.hero(aria-labelledby="hero-title")
      img.hero__portrait(src='/images/samuel-starling-1.jpg' alt='Portrait of Rev. Samuel Starling')
      hr.divider.divider--center
      h1#hero-title.hero__title Welcome to Samuel&apos;s Sermons
      p.hero__subtitle
        | This site is dedicated to preserving and sharing the powerful and inspiring sermons 
        | delivered by Rev. Samuel Starling during his years of ministry in the Methodist Church. 
        | These teachings reflect his wisdom, faith, and dedication to spiritual guidance.
      .hero__actions
        a.btn.btn--accent(href='/sermons') Explore Sermons
        a.btn.btn--outline(href='/about') About the Project

    //- Sermon of the Day
    if sermonOfDay
      section.section.sermon-of-day
        hr.divider.divider--center
        h2.sermon-of-day__heading Sermon of the Day
        .card
          .sermon-of-day__badge
            span.badge(class=sermonOfDay.sermonType === 'sermon' ? 'badge--sermon' : sermonOfDay.sermonType === 'funeral' ? 'badge--funeral' : 'badge--special')= sermonOfDay.sermonType
          h3.sermon-of-day__title= sermonOfDay.title
          a.btn.btn--primary(href=`/sermons/details?id=${sermonOfDay.id}`) Read This Sermon
