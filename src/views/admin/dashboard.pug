extends ../layout
block content
  header.page-header
    h1.page-header__title Dashboard
    hr.divider.divider--center
    if currentUser
      p.page-header__desc Welcome back, #{currentUser.display_name}.

  //- Quick profile card
  if currentUser
    .dashboard-profile
      - var avatarClass = currentUser.avatar === 'creator' ? 'dashboard-profile__avatar--creator' : currentUser.avatar === 'holy_cross' ? 'dashboard-profile__avatar--legendary' : (currentUser.avatarData && currentUser.avatarData.tier === 'admin') ? 'dashboard-profile__avatar--admin' : ''
      .dashboard-profile__avatar(class=avatarClass)= currentUser.avatarData ? currentUser.avatarData.emoji : '📖'
      .dashboard-profile__info
        h2.dashboard-profile__name= currentUser.display_name
        .dashboard-profile__roles
          - var roles = currentUser.role ? currentUser.role.split(',').map(r => r.trim()) : []
          each r in roles
            span.badge(class='badge--' + r)= r
        span.dashboard-profile__points= currentUser.total_points + ' points'
      a.btn.btn--small.btn--outline(href='/profile') View Profile

  //- Stats overview
  section.section
    .admin-stats
      .admin-stat
        span.admin-stat__number= stats.sermons
        span.admin-stat__label Sermons
      .admin-stat
        span.admin-stat__number= stats.transcribed
        span.admin-stat__label Transcribed
      .admin-stat
        span.admin-stat__number= stats.users
        span.admin-stat__label Team Members

  //- Structured sections
  .dashboard-grid
    //- Transcription work (transcriber + admin)
    if currentUser && currentUser.roles && (currentUser.roles.includes('admin') || currentUser.roles.includes('transcriber'))
      .dashboard-card
        h3.dashboard-card__title Transcription
        p.dashboard-card__desc Pick up a sermon to transcribe or review someone else's work.
        .dashboard-card__actions
          a.btn.btn--accent(href='/admin/transcribe') Transcribe
          a.btn.btn--outline(href='/admin/reviews') Review Queue

    //- Sermon management (uploader + admin)
    if currentUser && currentUser.roles && (currentUser.roles.includes('admin') || currentUser.roles.includes('uploader'))
      .dashboard-card
        h3.dashboard-card__title Sermons
        p.dashboard-card__desc Upload new scans, manage metadata, and move sermons through the pipeline.
        .dashboard-card__actions
          a.btn.btn--primary(href='/admin/sermons') Manage
          a.btn.btn--outline(href='/admin/sermons/add') Upload New

    //- Community (everyone)
    .dashboard-card
      h3.dashboard-card__title Community
      p.dashboard-card__desc See how the team is doing and check your own progress.
      .dashboard-card__actions
        a.btn.btn--outline(href='/admin/leaderboard') Leaderboard
        a.btn.btn--outline(href='/profile') My Profile

    //- Admin tools (admin only)
    if currentUser && currentUser.roles && currentUser.roles.includes('admin')
      .dashboard-card.dashboard-card--admin
        h3.dashboard-card__title Administration
        p.dashboard-card__desc Manage users, view activity, and create new accounts.
        .dashboard-card__actions
          a.btn.btn--outline(href='/admin/users') Users
          a.btn.btn--outline(href='/admin/activity') Activity Log
          a.btn.btn--outline(href='/auth/register') Create Account

    //- Developer tools (developer + admin)
    if currentUser && currentUser.roles && (currentUser.roles.includes('admin') || currentUser.roles.includes('developer'))
      .dashboard-card
        h3.dashboard-card__title Developer Tools
        p.dashboard-card__desc Track and resolve reported issues and bugs.
        .dashboard-card__actions
          a.btn.btn--primary(href='/issues') Issue Tracker
          a.btn.btn--outline(href='/admin/activity') Activity Log

    //- Report issue (everyone)
    .dashboard-card
      h3.dashboard-card__title Feedback
      p.dashboard-card__desc Found a bug or have an idea? Let the team know.
      .dashboard-card__actions
        a.btn.btn--outline(href='/issues/new') Report Issue
        a.btn.btn--outline(href='/issues/mine') My Issues
