extends ../layout
block title
  | Sign In | Samuel&apos;s Sermons
block content
  header.page-header
    h1.page-header__title Sign In
    hr.divider.divider--center(aria-hidden='true')

  .auth-form
    if error
      .auth-form__error(role='alert')= error

    form(method='POST' action='/auth/login')
      .form-group
        label(for='email') Email
        input#email.form-input(type='email' name='email' required autocomplete='email')
      .form-group
        label(for='password') Password
        input#password.form-input(type='password' name='password' required autocomplete='current-password')
      .form-group
        button.btn.btn--primary(type='submit') Sign In
