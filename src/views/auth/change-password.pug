extends ../layout
block content
  header.page-header
    h1.page-header__title Change Password
    hr.divider.divider--center
    if forced
      p.page-header__desc You must change your password before continuing.

  .auth-form
    if error
      .auth-form__error(role='alert')= error

    form(method='POST' action='/auth/change-password')
      if !forced
        .form-group
          label(for='current_password') Current Password
          input#current_password.form-input(type='password' name='current_password' required autocomplete='current-password')
      .form-group
        label(for='new_password') New Password
        input#new_password.form-input(type='password' name='new_password' required minlength='8' autocomplete='new-password')
        small.form-hint At least 8 characters.
      .form-group
        label(for='confirm_password') Confirm New Password
        input#confirm_password.form-input(type='password' name='confirm_password' required autocomplete='new-password')
      .form-group
        button.btn.btn--primary(type='submit') Change Password
