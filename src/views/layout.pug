doctype html
html(lang="en" data-theme="auto")
  head
    meta(charset="utf-8")
    //- Server prefs must come before the script below so it can read them
    if currentUser && currentUser.preferences
      script#serverPrefs(type='application/json')= JSON.stringify(currentUser.preferences)
    script.
      (function(){var d=document.documentElement,p={},s=document.getElementById('serverPrefs');if(s)try{p=JSON.parse(s.textContent)||{}}catch(e){}var t=localStorage.getItem('theme')||p.theme;d.setAttribute('data-theme',t||'auto');var z=localStorage.getItem('text_size')||p.text_size;if(z==='large'||z==='larger')d.setAttribute('data-text-size',z)})();
    title
      block title
        | #{pageTitle ? pageTitle + ' | ' : ''}Samuel&apos;s Sermons
    - var siteBase = SITE_URL || 'https://samuelsermons.com'
    - var metaDescription = pageDescription || "Home of Rev. Samuel Starling's Sermons created throughout his time in the Methodist Church."
    - var socialTitle = pageTitle ? pageTitle + " | Samuel's Sermons" : "Samuel's Sermons"
    - var socialImage = siteBase + '/images/screenshots/' + (pageScreenshot || 'home') + '-card.png'
    - var ld = jsonLd || (seo && !noindex ? seo.pageJsonLd(pageTitle, canonicalUrl) : null)
    link(rel='icon' type='image/svg+xml' href='/favicon.svg')
    link(rel='apple-touch-icon' href='/apple-touch-icon.png')
    meta(name='keywords' content='Samuel Starling Sermons Methodist Church Teachings')
    meta(name='description' content=metaDescription)
    meta(name='author' content='Starlingtek, LLC')
    if noindex
      meta(name='robots' content='noindex')
    if canonicalUrl
      link(rel='canonical' href=canonicalUrl)
    meta(property='og:site_name' content="Samuel's Sermons")
    meta(property='og:type' content=jsonLd && sermon ? 'article' : 'website')
    meta(property='og:title' content=socialTitle)
    meta(property='og:description' content=metaDescription)
    meta(property='og:image' content=socialImage)
    meta(property='og:url' content=canonicalUrl || siteBase + '/')
    meta(name='twitter:card' content='summary_large_image')
    meta(name='twitter:title' content=socialTitle)
    meta(name='twitter:description' content=metaDescription)
    meta(name='twitter:image' content=socialImage)
    if ld
      script(type='application/ld+json')!= seo.jsonForScript(ld)
    meta(name='viewport' content='width=device-width, initial-scale=1.0')
    link(rel='preconnect' href='https://fonts.googleapis.com')
    link(rel='preconnect' href='https://fonts.gstatic.com' crossorigin)
    link(href='https://fonts.googleapis.com/css2?family=Libre+Baskerville:ital,wght@0,400;0,700;1,400&family=Source+Sans+3:wght@400..700&family=Source+Serif+4:ital,opsz,wght@0,8..60,400..700;1,8..60,400..700&display=swap' rel='stylesheet')
    link(rel='stylesheet' href='/stylesheets/index.css')
    link(rel='alternate' type='application/rss+xml' title='Samuel\'s Sermons Activity Feed' href='/feed/rss')
    block head
  body
    a.skip-link(href='#main-content') Skip to main content

    header.site-header
      .container.site-header__inner
        a.site-header__brand(href='/')
          span.brand-mark(aria-hidden='true') S
          span.brand-text Samuel&apos;s Sermons
        button.site-header__toggle(type='button' aria-expanded='false' aria-controls='primary-nav')
          span(aria-hidden='true') &#9776;
          span.site-header__toggle-text Menu

        nav#primary-nav.site-header__nav(aria-label='Primary navigation')
          //- Public links
          .site-header__group
            a.site-header__link(href='/') Home
            a.site-header__link(href='/sermons') Sermons
            a.site-header__link(href='/about') About
            a.site-header__link(href='/bookmarks') Saved

          //- Authenticated links (after divider)
          if currentUser
            .site-header__divider(aria-hidden='true')
            .site-header__group
              a.site-header__link(href='/admin') Dashboard
              span.site-header__user= currentUser.display_name
              form.site-header__logout(method='POST' action='/auth/logout')
                button.site-header__link(type='submit') Sign Out
          else
            .site-header__divider(aria-hidden='true')
            .site-header__group
              a.site-header__link(href='/contact') Join
              a.site-header__link(href='/auth/login') Sign In

        //- Settings gear (always visible, opens dropdown)
        .site-header__settings
          button#settingsToggle.site-header__gear(type='button' aria-label='Settings' aria-expanded='false' aria-controls='settingsPanel')
            span(aria-hidden='true') &#9881;
          .site-header__settings-panel#settingsPanel(hidden)
            .settings-panel(role='group' aria-labelledby='settingsTitle')
              p#settingsTitle.settings-panel__title Settings
              //- Text size
              .settings-panel__item
                span#textSizeLabel.settings-panel__label Text size
                .settings-panel__options(role='group' aria-labelledby='textSizeLabel')
                  button.settings-panel__btn#textSizeNormal(type='button' aria-pressed='false' data-text-size='normal')
                    | A
                    span.sr-only  standard
                  button.settings-panel__btn#textSizeLarge(type='button' aria-pressed='false' data-text-size='large' style='font-size: 1.1em')
                    | A+
                    span.sr-only  large
                  button.settings-panel__btn#textSizeLarger(type='button' aria-pressed='false' data-text-size='larger' style='font-size: 1.25em')
                    | A++
                    span.sr-only  larger
              //- Theme
              .settings-panel__item
                span#themeLabel.settings-panel__label Theme
                .settings-panel__options(role='group' aria-labelledby='themeLabel')
                  button.settings-panel__btn#themeAuto(type='button' aria-pressed='false') Auto
                  button.settings-panel__btn#themeLight(type='button' aria-pressed='false') Light
                  button.settings-panel__btn#themeDark(type='button' aria-pressed='false') Dark

              //- Role-based settings
              if currentUser
                if currentUser.roles && currentUser.roles.includes('admin')
                  hr.settings-panel__divider
                  .settings-panel__item
                    span.settings-panel__label Admin
                    a.settings-panel__link(href='/admin/users') Manage Users
                    a.settings-panel__link(href='/auth/register') Create Account

                if currentUser.roles && (currentUser.roles.includes('admin') || currentUser.roles.includes('developer'))
                  hr.settings-panel__divider
                  .settings-panel__item
                    span.settings-panel__label Tools
                    a.settings-panel__link(href='/feed') Activity Feed

              //- Always show
              hr.settings-panel__divider
              .settings-panel__item
                span#offlineLabel.settings-panel__label Offline Mode
                .settings-panel__options(role='group' aria-labelledby='offlineLabel')
                  button.settings-panel__btn#offlineOff(type='button' aria-pressed='false') Off
                  button.settings-panel__btn#offlineOn(type='button' aria-pressed='false') On

              hr.settings-panel__divider
              .settings-panel__item
                span.settings-panel__label Help
                button.settings-panel__link#tourGeneral(type='button') Site Tour
                if currentUser
                  if currentUser.roles && (currentUser.roles.includes('admin') || currentUser.roles.includes('transcriber'))
                    button.settings-panel__link#tourTranscriber(type='button') Transcriber Guide
                  if currentUser.roles && (currentUser.roles.includes('admin') || currentUser.roles.includes('uploader'))
                    button.settings-panel__link#tourUploader(type='button') Uploader Guide

              hr.settings-panel__divider
              .settings-panel__item
                a.settings-panel__link(href='/profile') My Profile
                a.settings-panel__link(href='/auth/change-password') Change Password

    main#main-content.site-main(tabindex='-1')
      .container
        block content

    //- Offline mode consent modal
    //- Offline mode consent modal
    #offlineModal.ocr-modal(hidden)
      .ocr-modal__backdrop
      .ocr-modal__dialog(role='dialog' aria-labelledby='offlineModalTitle' aria-modal='true')
        h2#offlineModalTitle.ocr-modal__title Offline Mode
        p Enabling offline mode will download and cache the site's pages and sermon data so you can browse without an internet connection.
        p This will use storage on your device (typically a few MB, more if you view many sermon PDFs). Cached data stays until you turn offline mode off.
        p You can disable this at any time from the settings menu, which will clear the cached data.
        .ocr-modal__actions
          button#offlineAccept.btn.btn--primary(type='button') Enable Offline Mode
          button#offlineDecline.btn.btn--outline(type='button') Not Now

    //- Welcome modal for new users
    if showWelcome && currentUser
      #welcomeModal.ocr-modal
        .ocr-modal__backdrop
        .ocr-modal__dialog(role='dialog' aria-labelledby='welcomeTitle' aria-modal='true')
          h2#welcomeTitle.ocr-modal__title Welcome, #{currentUser.display_name}!
          p Thank you for joining the team to help preserve Rev. Samuel Starling's sermons. Your contribution makes a real difference.
          if currentUser.roles && currentUser.roles.includes('transcriber')
            p As a transcriber, you'll be helping digitize handwritten and typewritten sermons so they can be searched and shared with future generations.
          if currentUser.roles && currentUser.roles.includes('uploader')
            p As an uploader, you'll be scanning and adding sermon documents to the archive, moving them through the processing pipeline.
          if currentUser.roles && currentUser.roles.includes('developer')
            p As a developer, you have access to activity logs and metrics to help keep the platform running smoothly.
          if currentUser.roles && currentUser.roles.includes('admin')
            p As an admin, you have full access to manage users, sermons, and all platform features.
          p Would you like a quick tour to get oriented?
          .ocr-modal__check
            label.form-checkbox
              input#welcomeDismiss(type='checkbox')
              |  Don't show this again
          .ocr-modal__actions
            button#welcomeTour.btn.btn--primary(type='button') Take the Tour
            button#welcomeSkip.btn.btn--outline(type='button') Skip for Now

    //- Birthday memorial popup (May 6th only)
    #birthdayModal.ocr-modal(hidden)
      .ocr-modal__backdrop
      .ocr-modal__dialog.birthday-dialog(role='dialog' aria-labelledby='birthdayTitle' aria-modal='true' tabindex='-1')
        .birthday-header
          span.birthday-candle(aria-hidden='true') 🕯️
          h2#birthdayTitle.ocr-modal__title Remembering Samuel Starling
          span.birthday-candle(aria-hidden='true') 🕯️
        p.birthday-date May 6, 1940
        p Today marks the birthday of Rev. Samuel Starling. His wisdom, kindness, and faith continue to touch lives through the sermons preserved here.
        p If you'd like, leave a short message in his memory. These are collected and cherished by the family.
        .form-group
          label(for='birthdayName') Your name (optional)
          input#birthdayName.form-input(type='text' autocomplete='name' maxlength='100')
        .form-group
          label(for='birthdayMessage') Your message
          textarea#birthdayMessage.form-input(rows='3' placeholder='A birthday wish, a memory, or a word of thanks...' maxlength='2000' aria-describedby='birthdayMessageHint')
          span#birthdayMessageHint.form-hint(hidden) Please write a short message before sending.
        .ocr-modal__actions
          button#birthdaySend.btn.btn--accent(type='button') Send Message
          button#birthdayDismiss.btn.btn--outline(type='button') Maybe Later
        #birthdaySuccess.auth-form__success(hidden role='status') Thank you. Your message has been saved.

    //- Birthday popup logic
    script.
      (function() {
        var now = new Date();
        var month = now.getMonth();
        var day = now.getDate();
        if (month !== 4 || day !== 6) return;
        var year = now.getFullYear();
        var key = 'birthday_dismissed_' + year;
        if (localStorage.getItem(key)) return;
        var modal = document.getElementById('birthdayModal');
        var sendBtn = document.getElementById('birthdaySend');
        var dismissBtn = document.getElementById('birthdayDismiss');
        var nameInput = document.getElementById('birthdayName');
        var msgInput = document.getElementById('birthdayMessage');
        var successEl = document.getElementById('birthdaySuccess');
        if (!modal) return;
        var hint = document.getElementById('birthdayMessageHint');
        var lastFocus = document.activeElement;
        function close() {
          modal.hidden = true;
          if (lastFocus && lastFocus.focus) lastFocus.focus();
        }
        modal.hidden = false;
        modal.querySelector('.ocr-modal__dialog').focus();
        dismissBtn.addEventListener('click', close);
        modal.querySelector('.ocr-modal__backdrop').addEventListener('click', close);
        modal.addEventListener('keydown', function(e) { if (e.key === 'Escape') close(); });
        sendBtn.addEventListener('click', function() {
          var msg = msgInput.value.trim();
          if (!msg) {
            hint.hidden = false;
            msgInput.setAttribute('aria-invalid', 'true');
            msgInput.focus();
            return;
          }
          hint.hidden = true;
          msgInput.removeAttribute('aria-invalid');
          sendBtn.disabled = true;
          sendBtn.textContent = 'Sending...';
          fetch('/birthday/message', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ author_name: nameInput.value, message: msg }),
          }).then(function(r) { return r.json(); }).then(function(data) {
            if (data.ok) {
              // Stay open so the thank-you can be read at the visitor's own pace
              successEl.hidden = false;
              msgInput.value = '';
              localStorage.setItem(key, 'true');
              sendBtn.hidden = true;
              dismissBtn.textContent = 'Close';
              dismissBtn.focus();
            } else {
              sendBtn.textContent = 'Send Message';
              sendBtn.disabled = false;
            }
          }).catch(function() {
            sendBtn.textContent = 'Send Message';
            sendBtn.disabled = false;
          });
        });
      })();

    footer.site-footer
      .container
        p.site-footer__dedication Dedicated to the memory of Rev. Samuel Starling
        p.site-footer__links
          span &copy; #{new Date().getFullYear()} Samuel&apos;s Sermons
          span.site-footer__divider(aria-hidden='true') |
          a(href='mailto:transcribe@samuelsermons.com') transcribe@samuelsermons.com
          span.site-footer__divider(aria-hidden='true') |
          a(href='/feed') Activity Feed
          span.site-footer__divider(aria-hidden='true') |
          span
            | Made by 
            a(href='https://tylerstarling.com' target='_blank' rel='noopener noreferrer')
              | Tyler Starling
              span.sr-only  (opens in a new tab)

    //- Mobile nav toggle
    script.
      (function() {
        var toggle = document.querySelector('.site-header__toggle');
        var nav = document.getElementById('primary-nav');
        if (toggle && nav) {
          toggle.addEventListener('click', function() {
            var open = nav.getAttribute('data-open') === 'true';
            nav.setAttribute('data-open', !open);
            toggle.setAttribute('aria-expanded', !open);
          });
          nav.addEventListener('keydown', function(e) {
            if (e.key === 'Escape' && nav.getAttribute('data-open') === 'true') {
              nav.setAttribute('data-open', 'false');
              toggle.setAttribute('aria-expanded', 'false');
              toggle.focus();
            }
          });
        }

        // Mark the current page in the navigation (shape + screen reader cue, not color alone)
        var here = window.location.pathname.replace(/\/+$/, '') || '/';
        document.querySelectorAll('#primary-nav a.site-header__link').forEach(function(a) {
          var href = a.getAttribute('href');
          if (href === here || (href !== '/' && here.indexOf(href + '/') === 0)) {
            a.setAttribute('aria-current', 'page');
          }
        });
      })();

    //- Settings panel toggle + theme controls + preference sync
    script.
      (function() {
        var gear = document.getElementById('settingsToggle');
        var panel = document.getElementById('settingsPanel');
        if (!gear || !panel) return;

        // Check if user is logged in (server prefs element exists)
        var isLoggedIn = !!document.getElementById('serverPrefs');

        function savePreference(key, value) {
          localStorage.setItem(key, value);
          if (isLoggedIn) {
            var body = {};
            body[key] = value;
            fetch('/api/preferences', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify(body),
            }).catch(function() {});
          }
        }

        gear.addEventListener('click', function(e) {
          e.stopPropagation();
          var open = panel.hidden;
          panel.hidden = !open;
          gear.setAttribute('aria-expanded', open);
        });

        document.addEventListener('click', function(e) {
          if (!panel.contains(e.target) && !gear.contains(e.target)) {
            panel.hidden = true;
            gear.setAttribute('aria-expanded', 'false');
          }
        });

        document.addEventListener('keydown', function(e) {
          if (e.key === 'Escape' && !panel.hidden) {
            panel.hidden = true;
            gear.setAttribute('aria-expanded', 'false');
            gear.focus();
          }
        });

        // Selected state for a group of toggle buttons (aria-pressed + class)
        function markPressed(buttons, active) {
          buttons.forEach(function(b) {
            if (!b) return;
            var on = b === active;
            b.classList.toggle('settings-panel__btn--active', on);
            b.setAttribute('aria-pressed', on ? 'true' : 'false');
          });
        }

        // Text size (A / A+ / A++), remembered like the theme
        var sizeBtns = [document.getElementById('textSizeNormal'), document.getElementById('textSizeLarge'), document.getElementById('textSizeLarger')];
        function currentSize() {
          return document.documentElement.getAttribute('data-text-size') || 'normal';
        }
        function updateSize() {
          var cur = currentSize();
          markPressed(sizeBtns, sizeBtns.filter(function(b) { return b && b.getAttribute('data-text-size') === cur; })[0]);
        }
        sizeBtns.forEach(function(b) {
          if (!b) return;
          b.addEventListener('click', function() {
            var size = b.getAttribute('data-text-size');
            if (size === 'normal') document.documentElement.removeAttribute('data-text-size');
            else document.documentElement.setAttribute('data-text-size', size);
            savePreference('text_size', size);
            updateSize();
          });
        });
        updateSize();

        panel.addEventListener('click', function(e) { e.stopPropagation(); });

        var btnAuto = document.getElementById('themeAuto');
        var btnLight = document.getElementById('themeLight');
        var btnDark = document.getElementById('themeDark');

        function setTheme(t) {
          document.documentElement.setAttribute('data-theme', t);
          if (t === 'auto') {
            localStorage.removeItem('theme');
            savePreference('theme', 'auto');
          } else {
            savePreference('theme', t);
          }
          updateActive();
        }

        function updateActive() {
          var current = document.documentElement.getAttribute('data-theme') || 'auto';
          var active = current === 'light' ? btnLight : current === 'dark' ? btnDark : btnAuto;
          markPressed([btnAuto, btnLight, btnDark], active);
        }

        btnAuto.addEventListener('click', function() { setTheme('auto'); });
        btnLight.addEventListener('click', function() { setTheme('light'); });
        btnDark.addEventListener('click', function() { setTheme('dark'); });
        updateActive();

        // Tour buttons
        var tourGeneral = document.getElementById('tourGeneral');
        var tourTranscriber = document.getElementById('tourTranscriber');
        var tourUploader = document.getElementById('tourUploader');
        if (tourGeneral) tourGeneral.addEventListener('click', function() { panel.hidden = true; window.SiteTour && window.SiteTour.start('general'); });
        if (tourTranscriber) tourTranscriber.addEventListener('click', function() { panel.hidden = true; window.SiteTour && window.SiteTour.start('transcriber'); });
        if (tourUploader) tourUploader.addEventListener('click', function() { panel.hidden = true; window.SiteTour && window.SiteTour.start('uploader'); });
      })();

    //- Back to top button
    button.back-to-top#back-to-top(type='button' aria-label='Back to top' data-visible='false') &uarr;
    script(src='/javascripts/share.js' defer)
    script(src='/javascripts/tour.js' defer)
    script(src='/javascripts/tooltip.js' defer)

    //- Welcome modal logic
    script.
      (function() {
        var modal = document.getElementById('welcomeModal');
        if (!modal) return;
        var tourBtn = document.getElementById('welcomeTour');
        var skipBtn = document.getElementById('welcomeSkip');
        var dismissCheck = document.getElementById('welcomeDismiss');
        if (!tourBtn || !skipBtn) return;

        function dismiss(startTour) {
          var shouldDismiss = dismissCheck && dismissCheck.checked;
          if (shouldDismiss || startTour) {
            fetch('/api/preferences', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ welcome_dismissed: true }),
            }).catch(function() {});
          }
          modal.style.display = 'none';
          if (startTour && window.SiteTour) {
            window.SiteTour.start('general');
          }
        }

        tourBtn.addEventListener('click', function() { dismiss(true); });
        skipBtn.addEventListener('click', function() { dismiss(false); });
        modal.querySelector('.ocr-modal__backdrop').addEventListener('click', function() { dismiss(false); });
      })();

    //- Offline mode
    script.
      (function() {
        var offOn = document.getElementById('offlineOn');
        var offOff = document.getElementById('offlineOff');
        var modal = document.getElementById('offlineModal');
        var acceptBtn = document.getElementById('offlineAccept');
        var declineBtn = document.getElementById('offlineDecline');
        if (!offOn || !offOff) return;
        if (!modal || !acceptBtn || !declineBtn) return;

        var isEnabled = localStorage.getItem('offline_mode') === 'true';

        function updateButtons() {
          offOn.classList.toggle('settings-panel__btn--active', isEnabled);
          offOff.classList.toggle('settings-panel__btn--active', !isEnabled);
          offOn.setAttribute('aria-pressed', isEnabled ? 'true' : 'false');
          offOff.setAttribute('aria-pressed', isEnabled ? 'false' : 'true');
        }

        function enableSW() {
          if ('serviceWorker' in navigator) {
            navigator.serviceWorker.register('/sw.js').then(function() {
              isEnabled = true;
              localStorage.setItem('offline_mode', 'true');
              updateButtons();
            });
          }
        }

        function disableSW() {
          if ('serviceWorker' in navigator) {
            navigator.serviceWorker.getRegistrations().then(function(regs) {
              regs.forEach(function(r) { r.unregister(); });
            });
            caches.keys().then(function(names) {
              names.forEach(function(n) { caches.delete(n); });
            });
          }
          isEnabled = false;
          localStorage.removeItem('offline_mode');
          updateButtons();
        }

        offOn.addEventListener('click', function() {
          if (isEnabled) return;
          modal.hidden = false;
          acceptBtn.focus();
        });

        offOff.addEventListener('click', function() {
          if (!isEnabled) return;
          disableSW();
        });

        acceptBtn.addEventListener('click', function() {
          modal.hidden = true;
          enableSW();
        });

        function closeOffline() {
          modal.hidden = true;
          offOn.focus();
        }

        declineBtn.addEventListener('click', closeOffline);
        modal.querySelector('.ocr-modal__backdrop').addEventListener('click', closeOffline);
        modal.addEventListener('keydown', function(e) { if (e.key === 'Escape') closeOffline(); });

        // Auto-register if previously enabled
        if (isEnabled && 'serviceWorker' in navigator) {
          navigator.serviceWorker.register('/sw.js');
        }

        updateButtons();
      })();
    script.
      (function() {
        var btn = document.getElementById('back-to-top');
        if (!btn) return;
        window.addEventListener('scroll', function() {
          btn.setAttribute('data-visible', window.scrollY > 400 ? 'true' : 'false');
        }, { passive: true });
        btn.addEventListener('click', function() {
          var reduce = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
          window.scrollTo({ top: 0, behavior: reduce ? 'auto' : 'smooth' });
          var main = document.getElementById('main-content');
          if (main) main.focus({ preventScroll: true });
        });
      })();
