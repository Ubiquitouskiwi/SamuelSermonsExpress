doctype html
html(lang="en" data-theme="auto")
  head
    meta(charset="utf-8")
    script.
      (function(){var t=localStorage.getItem('theme');if(!t){var s=document.getElementById('serverPrefs');if(s)try{var p=JSON.parse(s.textContent);t=p.theme}catch(e){}}document.documentElement.setAttribute('data-theme',t||'auto')})();
    title #{pageTitle ? pageTitle + ' | ' : ''}Samuel&apos;s Sermons
    link(rel='icon' type='image/svg+xml' href='/favicon.svg')
    meta(name='keywords' content='Samuel Starling Sermons Methodist Church Teachings')
    meta(name='description' content="Home of Rev. Samuel Starling's Sermons created throughout his time in the Methodist Church.")
    meta(name='author' content='Starlingtek, LLC')
    meta(property='og:title' content=pageTitle ? pageTitle + ' | Samuel Sermons' : 'Samuel Sermons | Home')
    meta(property='og:description' content=pageDescription || "Home of Rev. Samuel Starling's Sermons created throughout his time in the Methodist Church.")
    meta(property='og:image' content=(SITE_URL || 'https://www.samuelsermons.com') + '/images/screenshots/' + (pageScreenshot || 'home') + '-card.png')
    meta(property='og:url' content=(SITE_URL || 'https://www.samuelsermons.com'))
    meta(name='twitter:card' content='summary_large_image')
    meta(name='twitter:image' content=(SITE_URL || 'https://www.samuelsermons.com') + '/images/screenshots/' + (pageScreenshot || 'home') + '-card.png')
    meta(name='viewport' content='width=device-width, initial-scale=1.0')
    link(rel='preconnect' href='https://fonts.googleapis.com')
    link(rel='preconnect' href='https://fonts.gstatic.com' crossorigin)
    link(href='https://fonts.googleapis.com/css2?family=Lora:ital,wght@0,400..700;1,400..700&family=Source+Sans+3:ital,wght@0,300..900;1,300..900&display=swap' rel='stylesheet')
    link(rel='stylesheet' href='/stylesheets/index.css')
    link(rel='alternate' type='application/rss+xml' title='Samuel\'s Sermons Activity Feed' href='/feed/rss')
    if currentUser && currentUser.preferences
      script#serverPrefs(type='application/json')= JSON.stringify(currentUser.preferences)
  body
    a.skip-link(href='#main-content') Skip to main content

    header.site-header
      .container.site-header__inner
        a.site-header__brand(href='/')
          span.brand-mark S
          span.brand-text Samuel&apos;s Sermons
        button.site-header__toggle(type='button' aria-label='Toggle navigation' aria-expanded='false' aria-controls='primary-nav') &#9776;

        nav#primary-nav.site-header__nav(aria-label='Primary navigation')
          //- Public links
          .site-header__group
            a.site-header__link(href='/') Home
            a.site-header__link(href='/sermons') Sermons
            a.site-header__link(href='/about') About
            a.site-header__link(href='/bookmarks') Saved

          //- Authenticated links (after divider)
          if currentUser
            .site-header__divider(aria-hidden='true')
            .site-header__group
              a.site-header__link(href='/admin') Dashboard
              span.site-header__user= currentUser.display_name
              form.site-header__logout(method='POST' action='/auth/logout')
                button.site-header__link(type='submit') Sign Out
          else
            .site-header__divider(aria-hidden='true')
            .site-header__group
              a.site-header__link(href='/contact') Join
              a.site-header__link(href='/auth/login') Sign In

        //- Settings gear (always visible, opens dropdown)
        .site-header__settings
          button#settingsToggle.site-header__gear(type='button' aria-label='Settings' aria-expanded='false' aria-controls='settingsPanel') &#9881;
          .site-header__settings-panel#settingsPanel(hidden)
            .settings-panel
              h3.settings-panel__title Settings
              //- Theme
              .settings-panel__item
                label.settings-panel__label Theme
                .settings-panel__options
                  button.settings-panel__btn#themeAuto(type='button') Auto
                  button.settings-panel__btn#themeLight(type='button') Light
                  button.settings-panel__btn#themeDark(type='button') Dark

              //- Role-based settings
              if currentUser
                if currentUser.roles && currentUser.roles.includes('admin')
                  hr.settings-panel__divider
                  .settings-panel__item
                    label.settings-panel__label Admin
                    a.settings-panel__link(href='/admin/users') Manage Users
                    a.settings-panel__link(href='/auth/register') Create Account

                if currentUser.roles && (currentUser.roles.includes('admin') || currentUser.roles.includes('developer'))
                  hr.settings-panel__divider
                  .settings-panel__item
                    label.settings-panel__label Tools
                    a.settings-panel__link(href='/feed') Activity Feed

              //- Always show
              hr.settings-panel__divider
              .settings-panel__item
                label.settings-panel__label Offline Mode
                .settings-panel__options
                  button.settings-panel__btn#offlineOff(type='button') Off
                  button.settings-panel__btn#offlineOn(type='button') On

              hr.settings-panel__divider
              .settings-panel__item
                label.settings-panel__label Help
                button.settings-panel__link#tourGeneral(type='button') Site Tour
                if currentUser
                  if currentUser.roles && (currentUser.roles.includes('admin') || currentUser.roles.includes('transcriber'))
                    button.settings-panel__link#tourTranscriber(type='button') Transcriber Guide
                  if currentUser.roles && (currentUser.roles.includes('admin') || currentUser.roles.includes('uploader'))
                    button.settings-panel__link#tourUploader(type='button') Uploader Guide

              hr.settings-panel__divider
              .settings-panel__item
                a.settings-panel__link(href='/profile') My Profile
                a.settings-panel__link(href='/auth/change-password') Change Password

    main#main-content.site-main
      .container
        block content

    //- Offline mode consent modal
    //- Offline mode consent modal
    #offlineModal.ocr-modal(hidden)
      .ocr-modal__backdrop
      .ocr-modal__dialog(role='dialog' aria-labelledby='offlineModalTitle' aria-modal='true')
        h2#offlineModalTitle.ocr-modal__title Offline Mode
        p Enabling offline mode will download and cache the site's pages and sermon data so you can browse without an internet connection.
        p This will use storage on your device (typically a few MB, more if you view many sermon PDFs). Cached data stays until you turn offline mode off.
        p You can disable this at any time from the settings menu, which will clear the cached data.
        .ocr-modal__actions
          button#offlineAccept.btn.btn--primary(type='button') Enable Offline Mode
          button#offlineDecline.btn.btn--outline(type='button') Not Now

    //- Welcome modal for new users
    if showWelcome && currentUser
      #welcomeModal.ocr-modal
        .ocr-modal__backdrop
        .ocr-modal__dialog(role='dialog' aria-labelledby='welcomeTitle' aria-modal='true')
          h2#welcomeTitle.ocr-modal__title Welcome, #{currentUser.display_name}!
          p Thank you for joining the team to help preserve Rev. Samuel Starling's sermons. Your contribution makes a real difference.
          if currentUser.roles && currentUser.roles.includes('transcriber')
            p As a transcriber, you'll be helping digitize handwritten and typewritten sermons so they can be searched and shared with future generations.
          if currentUser.roles && currentUser.roles.includes('uploader')
            p As an uploader, you'll be scanning and adding sermon documents to the archive, moving them through the processing pipeline.
          if currentUser.roles && currentUser.roles.includes('developer')
            p As a developer, you have access to activity logs and metrics to help keep the platform running smoothly.
          if currentUser.roles && currentUser.roles.includes('admin')
            p As an admin, you have full access to manage users, sermons, and all platform features.
          p Would you like a quick tour to get oriented?
          .ocr-modal__check
            label.form-checkbox
              input#welcomeDismiss(type='checkbox')
              |  Don't show this again
          .ocr-modal__actions
            button#welcomeTour.btn.btn--primary(type='button') Take the Tour
            button#welcomeSkip.btn.btn--outline(type='button') Skip for Now

    footer.site-footer
      .container
        p
          | &copy; #{new Date().getFullYear()} Samuel&apos;s Sermons
          span.site-footer__divider |
          a(href='mailto:transcribe@samuelsermons.com') transcribe@samuelsermons.com
          span.site-footer__divider |
          a(href='/feed') Activity Feed
          span.site-footer__divider |
          | Made by 
          a(href='https://tylerstarling.com' target='_blank' rel='noopener noreferrer') Tyler Starling

    //- Mobile nav toggle
    script.
      (function() {
        var toggle = document.querySelector('.site-header__toggle');
        var nav = document.getElementById('primary-nav');
        if (toggle && nav) {
          toggle.addEventListener('click', function() {
            var open = nav.getAttribute('data-open') === 'true';
            nav.setAttribute('data-open', !open);
            toggle.setAttribute('aria-expanded', !open);
          });
        }
      })();

    //- Settings panel toggle + theme controls + preference sync
    script.
      (function() {
        var gear = document.getElementById('settingsToggle');
        var panel = document.getElementById('settingsPanel');
        if (!gear || !panel) return;

        // Check if user is logged in (server prefs element exists)
        var isLoggedIn = !!document.getElementById('serverPrefs');

        function savePreference(key, value) {
          localStorage.setItem(key, value);
          if (isLoggedIn) {
            var body = {};
            body[key] = value;
            fetch('/api/preferences', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify(body),
            }).catch(function() {});
          }
        }

        gear.addEventListener('click', function(e) {
          e.stopPropagation();
          var open = panel.hidden;
          panel.hidden = !open;
          gear.setAttribute('aria-expanded', open);
        });

        document.addEventListener('click', function(e) {
          if (!panel.contains(e.target) && e.target !== gear) {
            panel.hidden = true;
            gear.setAttribute('aria-expanded', 'false');
          }
        });

        panel.addEventListener('click', function(e) { e.stopPropagation(); });

        var btnAuto = document.getElementById('themeAuto');
        var btnLight = document.getElementById('themeLight');
        var btnDark = document.getElementById('themeDark');

        function setTheme(t) {
          document.documentElement.setAttribute('data-theme', t);
          if (t === 'auto') {
            localStorage.removeItem('theme');
            savePreference('theme', 'auto');
          } else {
            savePreference('theme', t);
          }
          updateActive();
        }

        function updateActive() {
          var current = document.documentElement.getAttribute('data-theme') || 'auto';
          [btnAuto, btnLight, btnDark].forEach(function(b) { b.classList.remove('settings-panel__btn--active'); });
          if (current === 'auto') btnAuto.classList.add('settings-panel__btn--active');
          else if (current === 'light') btnLight.classList.add('settings-panel__btn--active');
          else if (current === 'dark') btnDark.classList.add('settings-panel__btn--active');
        }

        btnAuto.addEventListener('click', function() { setTheme('auto'); });
        btnLight.addEventListener('click', function() { setTheme('light'); });
        btnDark.addEventListener('click', function() { setTheme('dark'); });
        updateActive();

        // Tour buttons
        var tourGeneral = document.getElementById('tourGeneral');
        var tourTranscriber = document.getElementById('tourTranscriber');
        var tourUploader = document.getElementById('tourUploader');
        if (tourGeneral) tourGeneral.addEventListener('click', function() { panel.hidden = true; window.SiteTour && window.SiteTour.start('general'); });
        if (tourTranscriber) tourTranscriber.addEventListener('click', function() { panel.hidden = true; window.SiteTour && window.SiteTour.start('transcriber'); });
        if (tourUploader) tourUploader.addEventListener('click', function() { panel.hidden = true; window.SiteTour && window.SiteTour.start('uploader'); });
      })();

    //- Back to top button
    button.back-to-top#back-to-top(type='button' aria-label='Back to top' data-visible='false') &uarr;
    script(src='/javascripts/share.js')
    script(src='/javascripts/tour.js')
    script(src='/javascripts/tooltip.js')

    //- Welcome modal logic
    script.
      (function() {
        var modal = document.getElementById('welcomeModal');
        if (!modal) return;
        var tourBtn = document.getElementById('welcomeTour');
        var skipBtn = document.getElementById('welcomeSkip');
        var dismissCheck = document.getElementById('welcomeDismiss');
        if (!tourBtn || !skipBtn) return;

        function dismiss(startTour) {
          var shouldDismiss = dismissCheck && dismissCheck.checked;
          if (shouldDismiss || startTour) {
            fetch('/api/preferences', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ welcome_dismissed: true }),
            }).catch(function() {});
          }
          modal.style.display = 'none';
          if (startTour && window.SiteTour) {
            window.SiteTour.start('general');
          }
        }

        tourBtn.addEventListener('click', function() { dismiss(true); });
        skipBtn.addEventListener('click', function() { dismiss(false); });
        modal.querySelector('.ocr-modal__backdrop').addEventListener('click', function() { dismiss(false); });
      })();

    //- Offline mode
    script.
      (function() {
        var offOn = document.getElementById('offlineOn');
        var offOff = document.getElementById('offlineOff');
        var modal = document.getElementById('offlineModal');
        var acceptBtn = document.getElementById('offlineAccept');
        var declineBtn = document.getElementById('offlineDecline');
        if (!offOn || !offOff) return;
        if (!modal || !acceptBtn || !declineBtn) return;

        var isEnabled = localStorage.getItem('offline_mode') === 'true';

        function updateButtons() {
          offOn.classList.toggle('settings-panel__btn--active', isEnabled);
          offOff.classList.toggle('settings-panel__btn--active', !isEnabled);
        }

        function enableSW() {
          if ('serviceWorker' in navigator) {
            navigator.serviceWorker.register('/sw.js').then(function() {
              isEnabled = true;
              localStorage.setItem('offline_mode', 'true');
              updateButtons();
            });
          }
        }

        function disableSW() {
          if ('serviceWorker' in navigator) {
            navigator.serviceWorker.getRegistrations().then(function(regs) {
              regs.forEach(function(r) { r.unregister(); });
            });
            caches.keys().then(function(names) {
              names.forEach(function(n) { caches.delete(n); });
            });
          }
          isEnabled = false;
          localStorage.removeItem('offline_mode');
          updateButtons();
        }

        offOn.addEventListener('click', function() {
          if (isEnabled) return;
          modal.hidden = false;
          acceptBtn.focus();
        });

        offOff.addEventListener('click', function() {
          if (!isEnabled) return;
          disableSW();
        });

        acceptBtn.addEventListener('click', function() {
          modal.hidden = true;
          enableSW();
        });

        declineBtn.addEventListener('click', function() {
          modal.hidden = true;
        });

        modal.querySelector('.ocr-modal__backdrop').addEventListener('click', function() {
          modal.hidden = true;
        });

        // Auto-register if previously enabled
        if (isEnabled && 'serviceWorker' in navigator) {
          navigator.serviceWorker.register('/sw.js');
        }

        updateButtons();
      })();
    script.
      (function() {
        var btn = document.getElementById('back-to-top');
        if (!btn) return;
        window.addEventListener('scroll', function() {
          btn.setAttribute('data-visible', window.scrollY > 400 ? 'true' : 'false');
        }, { passive: true });
        btn.addEventListener('click', function() {
          window.scrollTo({ top: 0, behavior: 'smooth' });
        });
      })();
