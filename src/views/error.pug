extends layout
block content
  header.page-header
    h1.page-header__title Error
    hr.divider.divider--center

  .card
    h2= message || 'An error occurred'
    if error && error.status
      p Status code: #{error.status}
    else
      p We apologize for the inconvenience.
    a.btn.btn--primary(href='/') Return to Homepage

  if error && error.stack
    .card(style='margin-top: var(--space-xl);')
      h3 Technical Details
      pre= error.stack
