extends layout
block content
  a.back-link(href='/sermons') &larr; Back to Sermons

  h1.page-header__title= sermon.title.includes('.') ? sermon.title.split('. ')[1] : sermon.title
  hr.divider

  .sermon-detail
    aside.sermon-detail__sidebar
      .card
        h2.card__title Sermon Information
        dl.meta-list
          if sermon.title.includes('.')
            dt Number
            dd= sermon.title.split('.')[0]
          dt Type
          dd= sermon.sermonType.charAt(0).toUpperCase() + sermon.sermonType.slice(1)

        .action-stack
          button#bookmarkBtn.btn.btn--accent(type='button' data-sermon-id=sermon.id data-sermon-title=sermon.title) Bookmark
          a.btn.btn--outline(href=`mailto:transcribe@samuelsermons.com?subject=Sermon Transcription: ${sermon.title}`) Transcribe
          a.btn.btn--outline(href=sermon.imageLink download=sermon.title) Download PDF
          button.btn.btn--outline.share-trigger(type='button' data-share-url=`/sermons/details?id=${sermon.id}` data-share-title=sermon.title) Share

      .card
        h2.card__title Explore More
        .action-stack
          a.btn.btn--primary(href='/sermons') Browse All Sermons
          a.btn.btn--outline(href='/about') About This Archive

    section.sermon-detail__viewer(aria-label='Sermon document viewer')
      h2.sr-only Sermon Document
      a(href=sermon.imageLink target='_blank' rel='noopener noreferrer') Open PDF in new tab
      iframe(src=sermon.imageLink title=`PDF viewer for ${sermon.title}` loading='lazy')

      //- Transcription text (if available) — selectable for highlights
      if sermon.transcriptionText
        .sermon-detail__transcription
          .sermon-detail__transcription-header
            h3 Transcription
            if sermon.transcriptionStatus
              case sermon.transcriptionStatus
                when 'in_progress'
                  span.badge.badge--special In Progress
                when 'needs_review'
                  span.badge.badge--funeral Needs Review
                when 'complete'
                  span.badge.badge--sermon Complete
          p.section-desc Select any text below to save it as a highlight.
          .sermon-transcription-text#sermonText(data-sermon-id=sermon.id data-sermon-title=sermon.title)= sermon.transcriptionText

      //- Saved highlights for this sermon
      .sermon-detail__highlights
        h3 Your Highlights
        #sermonHighlights.highlight-list
          p.section-desc No highlights saved for this sermon.

  //- Highlight save popup (hidden, shown on text selection)
  #highlightPopup.highlight-popup(hidden)
    button#saveHighlight.btn.btn--small.btn--accent(type='button') Save Highlight

  script(src='/javascripts/sermon-interactions.js')
  script.
    // Track recently viewed
    (function() {
      var sermon = { id: !{sermon.id}, title: !{JSON.stringify(sermon.title)} };
      try {
        var recent = JSON.parse(localStorage.getItem('recently_viewed') || '[]');
        recent = recent.filter(function(s) { return s.id !== sermon.id; });
        recent.unshift(sermon);
        if (recent.length > 8) recent = recent.slice(0, 8);
        localStorage.setItem('recently_viewed', JSON.stringify(recent));
      } catch(e) {}
    })();
