extends layout
block content
  header.page-header
    h1.page-header__title Sermons Collection
    hr.divider.divider--center(aria-hidden='true')
    p.page-header__desc Browse through the collected teachings of Rev. Samuel Starling, preserved and digitized for future generations.

  section.section(aria-labelledby="sermons-heading")
    h2#sermons-heading.sr-only Sermon Listing

    .filter-toolbar
      //- Search with suggestions
      .filter-toolbar__search
        label.filter-toolbar__label(for='sermonSearch') Search sermons
        input#sermonSearch.filter-toolbar__input(type='search' placeholder='Type a title or word' autocomplete='off' aria-controls='searchSuggestions')
        #searchSuggestions.filter-toolbar__suggestions(hidden aria-label='Matching sermons')

      //- Collection toggle
      .filter-toolbar__group(role='group' aria-labelledby='collectionLabel')
        span#collectionLabel.filter-toolbar__label Collection
        .filter-toolbar__chips
          button.filter-chip.filter-chip--active(type='button' data-collection='all' aria-pressed='true') All
          button.filter-chip(type='button' data-collection='ordered' aria-pressed='false') Ordered
          button.filter-chip(type='button' data-collection='unordered' aria-pressed='false') Unordered

      //- Type multi-select chips (built dynamically from data)
      .filter-toolbar__group(role='group' aria-labelledby='typeLabel')
        span#typeLabel.filter-toolbar__label Type
        #typeChips.filter-toolbar__chips

      //- Count (announced politely when filters change)
      .filter-toolbar__count(role='status' aria-live='polite')
        span#sermonCount 0
        |  sermons

    //- Recently viewed (populated by JS from localStorage)
    #recentlyViewed.recently-viewed(hidden)
      h3.recently-viewed__heading Recently Viewed
      .recently-viewed__list

    #sermon-grid.sermon-grid
      //- Loading skeleton (hidden once JS renders cards)
      .sermon-grid__skeleton#gridSkeleton(aria-hidden='true')
        - for (var i = 0; i < 6; i++)
          .skeleton-card
            .skeleton-card__title
            .skeleton-card__badge

    #sermon-sentinel.sermon-sentinel(aria-hidden='true') Loading more sermons...

  script.
    window.__SERMONS__ = {
      ordered: !{JSON.stringify(orderedSermons)},
      unordered: !{JSON.stringify(unorderedSermons || [])}
    };
    window.__USER__ = {
      canTranscribe: !{JSON.stringify(!!(currentUser && currentUser.roles && (currentUser.roles.includes('admin') || currentUser.roles.includes('transcriber'))))}
    };
  script(src='/javascripts/sermons.js')
