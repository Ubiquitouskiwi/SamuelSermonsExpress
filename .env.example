# PostgreSQL
DATABASE_URL=postgresql://user:password@host:port/dbname?sslmode=require

# Session secret (generate a random string)
SESSION_SECRET=change-me-to-a-random-string

# DigitalOcean Spaces
DO_SPACES_KEY=your-spaces-access-key
DO_SPACES_SECRET=your-spaces-secret-key
DO_SPACES_ENDPOINT=https://nyc3.digitaloceanspaces.com
DO_SPACES_BUCKET=starlingtek-samuel-sermons
DO_SPACES_CDN=https://starlingtek-samuel-sermons.nyc3.cdn.digitaloceanspaces.com

# App
PORT=3000
NODE_ENV=development
SITE_URL=https://your-domain.com

# Initial admin account (used by db:seed)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=changeme123

# Creator avatar (optional — the email of the site creator gets a unique avatar)
CREATOR_EMAIL=
